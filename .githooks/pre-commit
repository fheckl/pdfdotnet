#!/usr/bin/env bash
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

staged_cs_files=()
while IFS= read -r -d '' file; do
    staged_cs_files+=("$file")
done < <(git diff --cached --name-only -z --diff-filter=ACMR -- '*.cs')

if ((${#staged_cs_files[@]} == 0)); then
    exit 0
fi

for file in "${staged_cs_files[@]}"; do
    if ! git diff --quiet -- "$file"; then
        printf 'Pre-commit: unstaged edits exist in staged C# file: %s\n' "$file" >&2
        printf 'Stage or stash those edits, then commit again.\n' >&2
        exit 1
    fi
done

dotnet format "$repo_root/PdfDotNet.slnx" --include "${staged_cs_files[@]}"
git add -- "${staged_cs_files[@]}"
