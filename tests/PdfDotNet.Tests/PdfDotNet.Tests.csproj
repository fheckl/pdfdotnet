<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.83.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PdfDotNet\PdfDotNet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\testassets\TestFont.ttf" Link="TestFont.ttf"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\..\testassets\TestFont.ttf')" />
  </ItemGroup>

</Project>